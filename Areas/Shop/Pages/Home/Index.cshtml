@page
@model VinylShop.Areas.Shop.Pages.Home.IndexModel
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers

<link rel="stylesheet" href="~/css/main.css"/>

<div class="fullscreen-bg">
    <div class="fullscreen-overlay"></div>
    <div class="fullscreen-content">
        <h1>VINYL SHOP</h1>
        <p>Онлайн-магазин вінілових платівок</p>
        <a href="/Shop/Albums/Albums" class="btn btn-success">🔍 Пошук в каталозі</a>
    </div>
</div>

<div class="albums-section">
    <div class="album-carousel">
        <button type="button" class="carousel-arrow carousel-prev" aria-label="Попередні">&#10094;</button>
        <div class="album-carousel-viewport">
            <div class="album-carousel-track">
                @foreach (var album in Model.Albums)
                {
                    <div class="album-card">
                        <a asp-area="Shop" asp-page="/Albums/Details" asp-route-id="@album.Id">
                            @if (!string.IsNullOrEmpty(album.ImagePath))
                            {
                                <img class="album-image" src="@album.ImagePath" alt="@album.Title" />
                            }

                            <div class="album-info">
                                <div class="album-genre">@album.Genre.Name</div>
                                <h5 class="album-title">@album.Title</h5>
                                <div class="album-artist">@album.Artist.Name</div>
                            </div>

                            <div class="price-block">
                                <div class="price-wrapper">
                                    <span class="price-highlight">@album.Price грн.</span>
                                </div>
                            </div>
                        </a>
                    </div>
                }
            </div>
        </div>
        <button type="button" class="carousel-arrow carousel-next" aria-label="Наступні">&#10095;</button>
    </div>
</div>
